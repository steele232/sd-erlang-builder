#!/usr/bin/env bash
# Model-check spec/tla/*.cfg with TLC (pinned tla2tools v1.7.4, fetched to archive/tla/).
#   bin/sd-tla            run every config; exit non-zero if an EXPECTED result differs
# Expected results are encoded in the config file name suffix:
#   *_none.cfg  must find a NamespaceConvergence violation (models 19.3 / O5)
#   a cfg containing "EXPECT: violation" must find a violation
#   other       must pass
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
JAR="$ROOT/archive/tla/tla2tools-1.7.4.jar"
SHA=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
if [ ! -f "$JAR" ]; then
  mkdir -p "$(dirname "$JAR")"
  curl -sSfL -o "$JAR" https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
fi
echo "$SHA  $JAR" | shasum -a 256 -c - >/dev/null
META="$ROOT/test-results/tla/.meta-$$"; mkdir -p "$META/tmp"   # under the repo: TLC also extracts its standard modules to java.io.tmpdir
rc=0
cd "$ROOT/spec/tla"
for cfg in *.cfg; do
  spec="${cfg%%_*}.tla"
  out="$(java -XX:+UseParallelGC -Djava.io.tmpdir="$META/tmp" -cp "$JAR" tlc2.TLC -workers 2 -deadlock \
           -metadir "$META/${cfg%.cfg}" -config "$cfg" "$spec" 2>&1 || true)"
  if grep -q "is violated\|were violated" <<<"$out"; then got=violation; elif grep -q "No error has been found" <<<"$out"; then got=pass; else got=error; fi
  case "$cfg" in *_none.cfg) want=violation ;; *) want=pass ;; esac
  grep -q "EXPECT: violation" "$cfg" && want=violation
  states="$(grep -Eo '[0-9,]+ distinct states found' <<<"$out" | tail -1 || true)"
  printf '%-28s %-10s (expected %-9s) %s\n' "$cfg" "$got" "$want" "$states"
  [ "$got" = "$want" ] || rc=1
done
exit $rc
