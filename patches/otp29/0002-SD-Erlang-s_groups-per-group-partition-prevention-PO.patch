+%% POP1 (decision D-5): A lost its link to X; X is reported for group G.
+%% Stock global's algorithm scoped to one group, with a logical removal: the
+%% receiver drops the far end from its in-sync set of G (and asks it to do
+%% the same); no link is cut.
+handle_cast({pop_lost, A, X, G, Seq} = Rep, S) ->
+    Stale = maps:get({A, X}, S#st.heals, -1) > Seq,
+    case maps:is_key(Rep, S#st.seen) orelse Stale orelse not maps:is_key(G, S#st.groups) of
+        true ->
+            {noreply, S};
+        false ->
+            S1 = S#st{seen = maps:put(Rep, true, S#st.seen)},
+            Fwd = maps:get(G, S1#st.sync, []) -- [A, X],
+            _ = [gen_server:cast({?MODULE, F}, Rep) || F <- Fwd],
+            V = case node() of X -> A; _ -> X end,
+            case lists:member(V, maps:get(G, S1#st.sync, [])) of
+                true ->
+                    gen_server:cast({?MODULE, V}, {pop_remove, node(), G}),
+                    {noreply, leave_partition(G, V, S1)};
+                false ->
+                    {noreply, S1}
+            end
     end;
+handle_cast({pop_remove, R, G}, S) ->
+    {noreply, leave_partition(G, R, S)};
+handle_cast({merge_request, G, From}, S) ->
+    %% From does not consider this node in step in G: whatever this node
+    %% thinks, they are not; drop From here too and merge.
+    self() ! merge_tick,
+    {noreply, leave_partition(G, From, S)};
+handle_cast({merge_done, G}, S) ->
+    {noreply, S#st{merging = maps:remove(G, S#st.merging)}};
