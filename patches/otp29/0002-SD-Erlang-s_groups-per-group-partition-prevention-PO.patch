+%%--------------------------------------------------------------------
+%% Partitions of a group (POP1) and the merge that heals them (R-NS-1)
+%%--------------------------------------------------------------------
+
+set_sync(G, Nodes, S) ->
+    L = lists:usort(Nodes),
+    ets:insert(?VIEW, {{sync, G}, L}),
+    S#st{sync = maps:put(G, L, S#st.sync)}.
+
+bump(N, S) ->
+    S#st{seq = maps:update_with(N, fun(V) -> V + 1 end, 1, S#st.seq)}.
+
+%% V is no longer in step with this node in G: drop it from the in-sync set
+%% and forget the names of its processes in G (they return with the merge).
+leave_partition(G, V, S) ->
+    case lists:member(V, maps:get(G, S#st.sync, [])) of
+        true ->
+            S1 = set_sync(G, maps:get(G, S#st.sync) -- [V], S),
+            Ns = maps:get(G, S1#st.names, #{}),
+            maps:fold(fun(Nm, P, Acc) when node(P) =:= V -> del_name(G, Nm, Acc);
+                         (_, _, Acc) -> Acc
+                      end, S1, Ns);
+        false ->
+            S
+    end.
+
+%% For each group: a connected member outside this node's partition is
+%% merged in. The smaller node of the pair initiates; one merge per group at
+%% a time. Merges that cannot run yet (not fully connected) are retried.
+merge_tick(S) ->
+    Connected = nodes(connected),
+    maps:fold(
+      fun(G, Members, Acc) ->
+              Missing = lists:sort([M || M <- Members, M =/= node(), lists:member(M, Connected),
+                                         not lists:member(M, maps:get(G, Acc#st.sync, []))]),
+              %% Views can be asymmetric (an install ran before a link was
+              %% up): ask a smaller missing node to merge, see merge_request.
+              _ = [gen_server:cast({?MODULE, M}, {merge_request, G, node()})
+                   || M <- Missing, M < node()],
+              case {[M || M <- Missing, node() < M], maps:is_key(G, Acc#st.merging)} of
+                  {[Y | _], false} ->
+                      Self = self(),
+                      _ = spawn(fun() ->
+                                        try merge(G, Y) catch _:_ -> ok end,
+                                        gen_server:cast(Self, {merge_done, G})
+                                end),
+                      Acc#st{merging = maps:put(G, true, Acc#st.merging)};
+                  _ ->
+                      Acc
+              end
+      end, S, S#st.groups).
+
+%% Merge this node's partition of G with Y's, under one lock on both: every
+%% pair must be connected (a fully connected partition, as stock global
+%% requires); conflicting names are resolved as 19.3 does (global's
+%% random_exit_name/3: keep the smaller pid, kill the other); a pid left
+%% with several names keeps the smallest (decision U1).
+merge(G, Y) ->
+    P0 = i_sync_set(G),
+    Y0 = rpc:call(Y, ?MODULE, i_sync_set, [G], ?T),
+    true = is_list(Y0),
+    locked(G, lists:usort(P0 ++ Y0),
+           fun() ->
+                   PI = i_sync_set(G),
+                   PY = rpc:call(Y, ?MODULE, i_sync_set, [G], ?T),
+                   true = is_list(PY),
+                   U = lists:usort(PI ++ PY),
+                   [] = lists:append([rpc:call(N, ?MODULE, i_connect_all, [U], ?T) || N <- U]),
+                   NI = i_names(G),
+                   NY = rpc:call(Y, ?MODULE, i_names, [G], ?T),
+                   true = is_map(NY),
+                   {Names, Losers} = resolve(NI, NY),
+                   Stamps = maps:from_list(
+                              [{{A, X}, Seq}
+                               || A <- U,
+                                  {X, Seq} <- maps:to_list(rpc:call(A, ?MODULE, i_seqs, [], ?T)),
+                                  lists:member(X, U)]),
+                   _ = multicall(U, i_merged, [G, U, Names, Stamps]),
+                   _ = [exit(L, kill) || L <- Losers],
+                   ok
+           end).
+
+resolve(NI, NY) ->
+    {Merged, Losers} =
+        maps:fold(fun(Nm, P, {Acc, Ls}) ->
+                          case maps:find(Nm, Acc) of
+                              error -> {maps:put(Nm, P, Acc), Ls};
+                              {ok, P} -> {Acc, Ls};
+                              {ok, Q} -> {maps:put(Nm, min(P, Q), Acc), [max(P, Q) | Ls]}
+                          end
+                  end, {NI, []}, NY),
+    ByPid = maps:groups_from_list(fun({_Nm, P}) -> P end, fun({Nm, _P}) -> Nm end,
+                                  maps:to_list(Merged)),
+    Extra = lists:append([lists:sort(Nms) -- [lists:min(Nms)] || Nms <- maps:values(ByPid)]),
+    {maps:without(Extra, Merged), Losers}.
+
