+%% After a node goes down, the names of its processes are checked every
+%% ?NODE_GC_STEP_MS: once the node is reachable again, its dead pids (dead
+%% processes, or pids of an earlier incarnation) are dropped; if it stays
+%% unreachable for ?NODE_GC_MS, all of them are. A deliberate re-dial
+%% reconnects within milliseconds and drops nothing.
+-define(NODE_GC_STEP_MS, 500).
+-define(NODE_GC_MS, 4000).
 
