@@ -672,6 +712,18 @@ static_groups({ok, Other}) -> {error, {bad_s_groups, Other}}.
 %% Partitions of a group (POP1) and the merge that heals them (R-NS-1)
 %%--------------------------------------------------------------------
 
+%% Drop the names of dead pids here and in the rest of each partition, so
+%% that all replicas agree (pid_down is idempotent).
+drop_dead(Dead, S) ->
+    lists:foldl(
+      fun({G, Nm, P}, Acc) ->
+              _ = [gen_server:cast({?MODULE, R}, {pid_down, G, Nm, P})
+                   || R <- maps:get(G, Acc#st.sync, [])],
+              del_pid_name(G, Nm, P, Acc)
+      end, S,
+      [{G, Nm, P} || {G, Ns} <- maps:to_list(S#st.names), {Nm, P} <- maps:to_list(Ns),
+                     lists:member(P, Dead)]).
+
 %% D-1 re-dials disconnect a link on purpose. Both ends are marked before the
 %% disconnect (the peer by a message sent ahead of it on the same link), so
 %% the nodedown neither drops names nor reports a lost link.
@@ -766,7 +818,7 @@ merge(G, Y) ->
                    NI = i_names(G),
                    NY = rpc:call(Y, ?MODULE, i_names, [G], ?T),
                    true = is_map(NY),
-                   {Names, Losers} = resolve(NI, NY),
+                   {Names, Losers} = resolve(alive_only(NI, U), alive_only(NY, U)),
                    Stamps = maps:from_list(
                               [{{A, X}, Seq}
                                || A <- U,
@@ -777,6 +829,17 @@ merge(G, Y) ->
                    ok
            end).
 
+%% A merge must never carry a dead pid into the union (e.g. one of an earlier
+%% incarnation of a restarted node): it could otherwise win a name conflict
+%% and kill the live process. Pids on reachable nodes are checked.
+alive_only(Names, U) ->
+    ByNode = maps:groups_from_list(fun node/1, lists:usort(maps:values(Names))),
+    Dead = lists:append(
+             [Ps -- (try erpc:call(Nd, ?MODULE, i_alive, [Ps], ?T) catch _:_ -> Ps end)
+              || {Nd, Ps} <- maps:to_list(ByNode),
+                 Nd =:= node() orelse lists:member(Nd, nodes(connected)) orelse lists:member(Nd, U)]),
+    maps:filter(fun(_Nm, P) -> not lists:member(P, Dead) end, Names).
+
