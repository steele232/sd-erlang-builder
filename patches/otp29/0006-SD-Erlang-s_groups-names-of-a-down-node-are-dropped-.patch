-handle_info({'DOWN', Ref, process, _Pid, noconnection}, S) ->
-    %% The link went down, not the process (e.g. the D-1 re-dial in
-    %% {mesh, _}). nodedown drops the name locally; the merge on reconnect
-    %% restores it. Never tell the other replicas the process died.
-    {noreply, S#st{mons = maps:remove(Ref, S#st.mons)}};
+handle_info({'DOWN', Ref, process, Pid, noconnection}, S)
+  when node(Pid) =/= node() ->
+    case lists:member(node(Pid), nodes(connected)) of
+        true ->
+            %% The node is connected, so the pid belongs to an earlier
+            %% incarnation of it (it restarted): the process is dead.
+            handle_info({'DOWN', Ref, process, Pid, dead_incarnation}, S);
+        false ->
+            %% The link went down, not the process (e.g. a D-1 re-dial).
+            %% The node's names go only if it stays down ({gc_node, ...});
+            %% the monitor is re-established when it reconnects. Never tell
+            %% the other replicas the process died.
+            {noreply, S#st{mons = maps:remove(Ref, S#st.mons)}}
+    end;
