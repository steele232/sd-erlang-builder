     case maps:take(Ref, S#st.mons) of
         {{G, Name}, Mons} ->
@@ -500,6 +519,29 @@ handle_info({nodedown, N, _Info}, S0) ->
         true -> {noreply, S1};              % a deliberate re-dial, not a failure
         false -> {noreply, node_lost(N, S1)}
     end;
+%% Liveness check for the names of N's processes after N went down (Seq).
+handle_info({gc_node, N, Seq, Left}, S) ->
+    Pids = lists:usort([P || Ns <- maps:values(S#st.names), P <- maps:values(Ns), node(P) =:= N]),
+    Connected = lists:member(N, nodes(connected)),
+    if
+        Pids =:= [] ->
+            {noreply, S};
+        Connected ->
+            Self = self(),
+            _ = spawn(fun() ->
+                              Alive = try erpc:call(N, ?MODULE, i_alive, [Pids], ?T)
+                                      catch _:_ -> Pids
+                                      end,
+                              gen_server:cast(Self, {pids_dead, Pids -- Alive})
+                      end),
+            {noreply, S};
+        Left =< 0 ->
+            {noreply, drop_dead(Pids, S)};
+        true ->
+            _ = erlang:send_after(?NODE_GC_STEP_MS, self(),
+                                  {gc_node, N, Seq, Left - ?NODE_GC_STEP_MS}),
+            {noreply, S}
+    end;
 handle_info(merge_tick, S) ->
     {noreply, merge_tick(S)};
