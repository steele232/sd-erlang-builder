From ef9b8aac81d701e10aa2c8445e17dc0cd8e70de8 Mon Sep 17 00:00:00 2001
From: Jonathan Steele <jonathan@renew-it.us>
Date: Mon, 19 Oct 2026 16:03:42 -0700
Subject: [PATCH 11/13] SD Erlang s_groups: free-namespace re-dial is eventual
 too (model-found race)

---
 lib/kernel/src/s_group.erl | 26 ++++++++++++++++++++------
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/lib/kernel/src/s_group.erl b/lib/kernel/src/s_group.erl
index ce8eab6..130da51 100644
--- a/lib/kernel/src/s_group.erl
+++ b/lib/kernel/src/s_group.erl
@@ -817,20 +817,34 @@ merge_tick(S) ->
 %% before one end had installed the group, e.g. while install's own connect
 %% was still in its handshake) is re-dialled, once the other end also lists
 %% this node as a fellow member, so it comes back visible.
+%% The same holds for two free normal nodes (D-1 for the free namespace): the
+%% one-shot re-dial on becoming free misses a link whose handshake is still in
+%% flight (found by spec/tla/SGroupVisibility.tla), so the tick repeats it.
 mesh_tick(S) ->
     Mine = lists:usort(lists:append(maps:values(S#st.groups))) -- [node()],
     Candidates = [N || N <- nodes(hidden), lists:member(N, Mine),
-                       not maps:is_key(N, S#st.redial)],
+                       not maps:is_key(N, S#st.redial)]
+        ++ case free_normal(S) of
+               true -> [N || N <- nodes(hidden), not maps:is_key(N, S#st.redial)];
+               false -> []
+           end,
     case Candidates of
         [] -> S;
         _ ->
             Self = self(),
             _ = spawn(fun() ->
-                              Ready = [N || N <- Candidates,
-                                            lists:member(node(),
-                                                         try erpc:call(N, ?MODULE, own_nodes, [], ?T)
-                                                         catch _:_ -> []
-                                                         end)],
+                              Free = map_size(S#st.groups) =:= 0,
+                              Ready = [N || N <- lists:usort(Candidates),
+                                            case Free of
+                                                true ->
+                                                    (try erpc:call(N, ?MODULE, i_is_free, [], ?T)
+                                                     catch _:_ -> false end) =:= true;
+                                                false ->
+                                                    lists:member(node(),
+                                                                 try erpc:call(N, ?MODULE, own_nodes, [], ?T)
+                                                                 catch _:_ -> []
+                                                                 end)
+                                            end],
                               gen_server:call(Self, {redial, Ready}, ?T),
                               [redial(N) || N <- Ready]
                       end),
