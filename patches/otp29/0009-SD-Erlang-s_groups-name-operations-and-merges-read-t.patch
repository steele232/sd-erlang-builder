                  end).
 
 whereis_name(G, Name) ->
@@ -864,12 +864,16 @@ merge(G, Y) ->
     P0 = i_sync_set(G),
     Y0 = rpc:call(Y, ?MODULE, i_sync_set, [G], ?T),
     true = is_list(Y0),
-    locked(G, lists:usort(P0 ++ Y0),
+    U0 = lists:usort(P0 ++ Y0),
+    locked(G, U0,
            fun() ->
                    PI = i_sync_set(G),
                    PY = rpc:call(Y, ?MODULE, i_sync_set, [G], ?T),
                    true = is_list(PY),
                    U = lists:usort(PI ++ PY),
+                   %% Only install where the lock is held; a grown union is
+                   %% merged by a later tick.
+                   [] = U -- U0,
                    [] = lists:append([rpc:call(N, ?MODULE, i_connect_all, [U], ?T) || N <- U]),
                    NI = i_names(G),
                    NY = rpc:call(Y, ?MODULE, i_names, [G], ?T),
@@ -967,6 +971,25 @@ in_sync(G) ->
     catch error:badarg -> []
     end.
 
+%% Run Fun(Partition) under the group lock on this node's partition of G.
+%% The partition is read again inside the lock: if it has grown meanwhile (a
+%% merge brought nodes in while this caller waited), the lock does not cover
+%% it, so take it again on the larger set. Writing to a partition read before
+%% the lock lost a registration on a merged-in member (O5 probe).
+locked_partition(G, Fun) ->
+    P0 = [node() | in_sync(G)],
+    case locked(G, P0, fun() ->
+                               P1 = [node() | in_sync(G)],
+                               case P1 -- P0 of
+                                   [] -> {done, Fun(P1)};
+                                   _ -> retry
+                               end
+                       end) of
+        {done, R} -> R;
+        retry -> locked_partition(G, Fun);
+        Other -> Other
+    end.
+
 %% Group-wide lock on all members (global:trans with an explicit node list).
 locked(G, Members, Fun) ->
     case global:trans({{?MODULE, G}, self()}, Fun, Members, infinity) of
