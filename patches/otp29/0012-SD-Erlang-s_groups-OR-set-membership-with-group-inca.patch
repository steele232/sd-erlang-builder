+%% ---- membership as an observed-remove set (D-8)
+
+%% Tags and incarnations are plain terms (the -rsconfig record is text read
+%% back by -config, so no refs): unique across nodes and restarts.
+mk_tag() -> {node(), erlang:system_time(), erlang:unique_integer([positive])}.
+
+ms_members({_Inc, Adds, Rems}) ->
+    lists:sort([N || {N, Tags} <- maps:to_list(Adds), Tags -- Rems =/= []]).
+
+ms_join({Inc, A1, R1}, {Inc, A2, R2}) ->
+    {Inc, maps:merge_with(fun(_, T1, T2) -> lists:usort(T1 ++ T2) end, A1, A2),
+     lists:usort(R1 ++ R2)}.
+
+ms_norm(undefined) -> undefined;
+ms_norm({Inc, A, R}) -> {Inc, lists:sort([{N, lists:sort(T)} || {N, T} <- maps:to_list(A)]), lists:sort(R)}.
+
+ms_groups(MS) ->
+    maps:filter(fun(_, Ns) -> lists:member(node(), Ns) end,
+                maps:map(fun(_, M) -> ms_members(M) end, MS)).
+
+%% Join a received view of G into this node's (same incarnation only, S7)
+%% and re-derive membership; leave G if this node is no longer a member.
+join_ms(G, MS2, S) ->
+    case {maps:get(G, S#st.ms, undefined), MS2} of
+        {{Inc, _, _} = MS1, {Inc, _, _}} ->
+            MS = ms_join(MS1, MS2),
+            Members = ms_members(MS),
+            S1 = S#st{ms = maps:put(G, MS, S#st.ms)},
+            case lists:member(node(), Members) of
+                true -> set_groups(maps:put(G, Members, S1#st.groups), S1);
+                false -> drop_group(G, S1)
+            end;
+        _ ->
+            S
+    end.
+
+drop_group(G, S) ->
+    Tomb = case maps:get(G, S#st.ms, undefined) of
+               {Inc, _, _} -> maps:put({G, Inc}, true, S#st.tomb);
+               undefined -> S#st.tomb
+           end,
+    S0 = S#st{ms = maps:remove(G, S#st.ms), tomb = Tomb},
+    S1 = set_groups(maps:remove(G, S0#st.groups), S0#st{names = maps:remove(G, S0#st.names)}),
+    ets:delete(?VIEW, {sync, G}),
+    S1#st{sync = maps:remove(G, S1#st.sync)}.
+
+%% Claims at boot (D-7): from -rsconfig's recorded state if present, else
+%% from the launch configuration with deterministic tags, so that every node
+%% booting from one config agrees and a removal of {static, G, N} also
+%% defeats N's later static claim.
+initial_claims(Groups) ->
+    Recorded = case application:get_env(kernel, s_group_state) of
+                   {ok, Rec} when is_map(Rec) -> Rec;
+                   _ -> #{}
+               end,
+    Tomb = case application:get_env(kernel, s_group_tombstones) of
+               {ok, L} when is_list(L) -> maps:from_list([{K, true} || K <- L]);
+               _ -> #{}
+           end,
+    MS = maps:map(fun(G, Ns) ->
+                          case maps:find(G, Recorded) of
+                              {ok, M} -> M;
+                              error -> {{static, G}, maps:from_list([{N, [{static, G, N}]} || N <- Ns]), []}
+                          end
+                  end, Groups),
+    {MS, Tomb}.
+
+ae_ms() ->
+    case application:get_env(kernel, s_group_anti_entropy_ms) of
+        {ok, N} when is_integer(N), N >= 0 -> N;
+        _ -> ?AE_MS
+    end.
