 %% Partitions of a group (POP1) and the merge that heals them (R-NS-1)
 %%--------------------------------------------------------------------
 
+%% D-1 re-dials disconnect a link on purpose. Both ends are marked before the
+%% disconnect (the peer by a message sent ahead of it on the same link), so
+%% the nodedown neither drops names nor reports a lost link.
+mark_redial(Nodes, S) ->
+    S#st{redial = lists:foldl(fun(N, M) -> maps:put(N, true, M) end, S#st.redial, Nodes)}.
+
+redial(N) ->
+    gen_server:cast({?MODULE, N}, {redialing, node()}),
+    erlang:disconnect_node(N),
+    net_kernel:connect_node(N).
+
+%% Names whose pid lives on N lost their monitor when the link went down
+%% ('DOWN' noconnection); monitor them again now that N is back.
+remonitor(N, S) ->
+    Monitored = maps:values(S#st.mons),
+    maps:fold(fun(G, Ns, Acc) ->
+                      maps:fold(fun(Nm, P, A) when node(P) =:= N ->
+                                        case lists:member({G, Nm}, Monitored) of
+                                            true -> A;
+                                            false ->
+                                                Ref = erlang:monitor(process, P),
+                                                A#st{mons = maps:put(Ref, {G, Nm}, A#st.mons)}
+                                        end;
+                                   (_, _, A) -> A
+                                end, Acc, Ns)
+              end, S, S#st.names).
+
 set_sync(G, Nodes, S) ->
     L = lists:usort(Nodes),
     ets:insert(?VIEW, {{sync, G}, L}),
