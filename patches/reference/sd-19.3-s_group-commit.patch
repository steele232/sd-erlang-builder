+combine_known(_, [], _, CmbSGroupNodes) ->
+    CmbSGroupNodes;
+combine_known(Node, [Group | SGroups], SGroupNodes, CmbSGroupNodes) ->
+    NewNodes = case lists:keyfind(Group, 1, SGroupNodes) of
