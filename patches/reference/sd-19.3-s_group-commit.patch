+exchange_ops_s_known([], Known, _S) ->
+    Known;
+exchange_ops_s_known([SGroup | SGroups], Known, S) ->
+    NewKnown = case lists:keyfind(SGroup, 1, S#state.known) of 
+                         false -> [];
+                         {SGroup, Nodes} -> Nodes
+               end,
+    exchange_ops_s_known(SGroups, [{SGroup, NewKnown} | Known], S).
