+sync_others_s(CmnNodeSGroups) ->
+    %% CmnNodeSGroups::[{Node, [SGroupName]}]
+    ?debug({"sync_others_s_CmnNodeSGroups", CmnNodeSGroups}),
+    N = case application:get_env(kernel, ?N_CONNECT_RETRIES) of
