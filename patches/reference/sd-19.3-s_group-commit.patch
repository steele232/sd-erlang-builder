+%%%====================================================================================
+%%% Kill any possible s_group_check processes
+%%%====================================================================================
+kill_s_group_check() ->
+    case whereis(s_group_check) of
+	undefined ->
+	    ok;
+	Pid ->
+	    unlink(Pid),
+	    s_group_check ! kill,
+	    unregister(s_group_check)
+    end.
+
