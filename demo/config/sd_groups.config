%% Static s_group topology for the 3-node demo (historical SD Erlang 19.3 format).
%%
%%            local_ai                external_ai
%%   gpu1 ───────────── gateway ───────────── connector
%%
%% gateway belongs to both groups; gpu1 and connector share no group,
%% so SD Erlang must NOT connect them transitively through gateway.
[
 {kernel,
  [
   {s_groups,
    [
     {local_ai, normal,
      ['gateway@gateway.sd.lab',
       'gpu1@gpu1.sd.lab']},

     {external_ai, normal,
      ['gateway@gateway.sd.lab',
       'connector@connector.sd.lab']}
    ]}
  ]}
].
