%% 15-node SD Erlang topology (historical 19.3 config format).
%%
%%                       control
%%            core1  core2  core3  gw1  gw2
%%                                 /      \
%%                local_ai        /        \        edge_ai
%%   gw1 gpu1 gpu2 gpu3 gpu4  ---+          +---  gw2 edge1 edge2 edge3 edge4
%%                                \        /
%%                               external_ai
%%                          gw1  gw2  saas1  saas2
%%
%% Allowed visible links = union of per-group cliques = 35 (stock full mesh = 105).
%% `sd_demo` section: per-node discovery seeds and services. A node only pings
%% seeds it currently shares an s_group with; all other links must come from
%% SD global's intra-group meshing. Node list must match bin/sd-demo15 NODES.
[
 {kernel,
  [
   {s_groups,
    [
     {control, normal,
      ['core1@core1.sd.lab',
       'core2@core2.sd.lab',
       'core3@core3.sd.lab',
       'gw1@gw1.sd.lab',
       'gw2@gw2.sd.lab']},

     {local_ai, normal,
      ['gw1@gw1.sd.lab',
       'gpu1@gpu1.sd.lab',
       'gpu2@gpu2.sd.lab',
       'gpu3@gpu3.sd.lab',
       'gpu4@gpu4.sd.lab']},

     {edge_ai, normal,
      ['gw2@gw2.sd.lab',
       'edge1@edge1.sd.lab',
       'edge2@edge2.sd.lab',
       'edge3@edge3.sd.lab',
       'edge4@edge4.sd.lab']},

     {external_ai, normal,
      ['gw1@gw1.sd.lab',
       'gw2@gw2.sd.lab',
       'saas1@saas1.sd.lab',
       'saas2@saas2.sd.lab']}
    ]}
  ]},

 {sd_demo,
  [
   {topology,
    [     {'core1@core1.sd.lab',
      [{seeds, ['gw1@gw1.sd.lab']},
       {services, []}]},
     {'core2@core2.sd.lab',
      [{seeds, ['gw1@gw1.sd.lab']},
       {services, []}]},
     {'core3@core3.sd.lab',
      [{seeds, ['gw1@gw1.sd.lab']},
       {services, []}]},
     {'gw1@gw1.sd.lab',
      [{seeds, ['gw2@gw2.sd.lab']},
       {services, [{router, control, router_a}]}]},
     {'gw2@gw2.sd.lab',
      [{seeds, []},
       {services, [{router, control, router_b}]}]},
     {'gpu1@gpu1.sd.lab',
      [{seeds, ['gw1@gw1.sd.lab']},
       {services, [{worker, local_ai}]}]},
     {'gpu2@gpu2.sd.lab',
      [{seeds, ['gw1@gw1.sd.lab']},
       {services, []}]},
     {'gpu3@gpu3.sd.lab',
      [{seeds, ['gw1@gw1.sd.lab']},
       {services, []}]},
     {'gpu4@gpu4.sd.lab',
      [{seeds, ['gw1@gw1.sd.lab']},
       {services, []}]},
     {'edge1@edge1.sd.lab',
      [{seeds, ['gw2@gw2.sd.lab']},
       {services, [{worker, edge_ai}]}]},
     {'edge2@edge2.sd.lab',
      [{seeds, ['gw2@gw2.sd.lab']},
       {services, []}]},
     {'edge3@edge3.sd.lab',
      [{seeds, ['gw2@gw2.sd.lab']},
       {services, []}]},
     {'edge4@edge4.sd.lab',
      [{seeds, ['gw2@gw2.sd.lab', 'gw1@gw1.sd.lab']},
       {services, []}]},
     {'saas1@saas1.sd.lab',
      [{seeds, ['gw2@gw2.sd.lab']},
       {services, [{worker, external_ai}]}]},
     {'saas2@saas2.sd.lab',
      [{seeds, ['gw2@gw2.sd.lab']},
       {services, []}]}
    ]}
  ]}
].
